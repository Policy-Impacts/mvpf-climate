. *****************************************
. /* Calculating Sales-Weighted Averages */
. *****************************************
. 
. forvalues y = 2011(1)2020{
  2.     gen num`y' = sales`y' * kwh_per_mile`y'
  3.     egen num2`y' = total(num`y')
  4.     egen den`y' = total(sales`y') if !missing(kwh_per_mile`y') & kwh_per_mile`y' != 0
  5.     gen avg_kwh_per_mile`y' = num2`y' / den`y'
  6.     drop num`y' num2`y' den`y'
  7. }
