. forv i = 1999(1)2020{
  2.         egen msrp_N`i' = total(sales_msrp`i')
  3.         egen batt_cap_N`i' = total(sales_batt_cap`i')
  4.         egen mpg_N`i' = total(sales_mpg`i')
  5.         egen msrp_weighted_avg`i' = total(sales_msrp`i' * msrp`i')
  6.         replace msrp_weighted_avg`i' = msrp_weighted_avg`i' / msrp_N`i'
  7.         egen batt_cap_weighted_avg`i' = total(sales_batt_cap`i' * batt_cap`i')
  8.         replace batt_cap_weighted_avg`i' = batt_cap_weighted_avg`i' / batt_cap_N`i'
  9.         egen mpg_weighted_avg`i' = total(sales_mpg`i' * mpg`i')
 10.         replace mpg_weighted_avg`i' = mpg_weighted_avg`i' / mpg_N`i'
 11. }
