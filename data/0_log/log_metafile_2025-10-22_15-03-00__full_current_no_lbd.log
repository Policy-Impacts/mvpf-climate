. di in yellow "Looking for folders ending with pattern: `pattern_suffix'"
Looking for folders ending with pattern: full_current_193

. * Find all folders in the results directory that end with the pattern
. local results_dir = "${code_files}/4_results"

. local folder_list = ""

. local folder_dates = ""

. * Get list of all subdirectories
. qui local folders : dir "`results_dir'" dirs "*"

. * Filter folders that end with our pattern and extract timestamps
. foreach folder of local folders {
  2.     if regexm("`folder'", "^([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2})__`pattern_suffix'$") {
  3.         local timestamp = regexs(1)
  4.         local folder_list = "`folder_list' `folder'"
  5.         local folder_dates = "`folder_dates' `timestamp'"
  6.         di in green "Found matching folder: `folder' (timestamp: `timestamp')"
  7.     }
  8. }
Found matching folder: 2025-09-25_13-45-54__full_current_193 (timestamp: 2025-09-25_13-45-54)
Found matching folder: 2025-10-21_01-03-46__full_current_193 (timestamp: 2025-10-21_01-03-46)

. * If no matching folders found, display error and exit
