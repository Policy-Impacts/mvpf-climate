. * Filter folders that end with our pattern and extract timestamps
. foreach folder of local folders {
  2.     if regexm("`folder'", "^([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2})__`pattern_suffix'$") {
  3.         local timestamp = regexs(1)
