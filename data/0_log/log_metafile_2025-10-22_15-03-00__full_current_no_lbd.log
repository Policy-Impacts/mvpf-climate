> her_compiled" & program != "cw_datta" & program != "dw_datta" & ///
>                                                                                  program != "fridge_datta" & program != "wisc_rf") | inli
> st(program, "ca_electric", "cookstoves", "mx_deforest", "ug_deforest")
(18 real changes made)

