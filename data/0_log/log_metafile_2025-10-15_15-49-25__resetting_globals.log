.         local local_benefit = (`local_benefit_CA' * `CA_pop_2011' + `local_benefit_MA' * `MA_pop_2011' + `local_benefit_PA' * `PA_pop_2011' + `local_benefit_TN' * `TN_pop_2011' + `l
