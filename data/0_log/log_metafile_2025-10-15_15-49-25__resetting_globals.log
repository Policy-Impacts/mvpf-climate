 11. 
.                         qui sum `c'_taxes if year == `y'
 12.                         global `c'_cf_gas_fisc_ext_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 13.                         
.                         qui sum `c'_savings if year == `y'
 14.                         global `c'_cf_gas_savings_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 15. 
.                         qui sum `c'_profits if year == `y'
 16.                         global `c'_wtp_prod_s_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 17. 
.                         qui sum `c'_gallons if year == `y'
 18.                         global `c'_gal_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 19.                         
.                         qui sum `c'_local_driving if year == `y'
 20.                         global `c'_driving_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 21.                         
.                         qui sum `c'_mpg if year == `y'
 22.                         global `c'_cf_mpg_`y' = r(mean)
 23.                         
.                 }
 24.                 if "`c'" != "${bev_cf}" {
 25.                         
.                         qui sum `c'_local if year == `y' // for hybrids, includes rebound effect
 26.                         global `c'_cf_damages_loc_`y' = r(mean) // for hybrids, includes rebound effect
 27. 
.                         qui sum `c'_global if year == `y' // for hybrids, includes rebound effect
 28.                         global `c'_cf_damages_glob_`y' = r(mean) // for hybrids, includes rebound effect
 29. 
