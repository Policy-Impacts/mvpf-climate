. /* 4 -  Run Externality Calculations that Depend on Earlier Calculations (EVs, Hybrids, Vehicle Retirement). */
. ***************************************************************************************************************
. 
. *-----------------------------------------------------------------------
. * 4a - Lifetime Vehicle Damages. 
. *-----------------------------------------------------------------------
. local object_of_interest = "Benefits from Not Driving Gasoline-powered Vehicle"

.         
. if "${rerun_macros}" == "yes" {
.         di in red "Asked to Rerun `object_of_interest'"
Asked to Rerun Benefits from Not Driving Gasoline-powered Vehicle
.         qui do "${calculation_files}/lifetime_vehicle_externalities"
. }

. 
. if fileexists("${user_specific_assumptions}/files_v${user_name}/Vehicle Lifetime Damages/vehicles_${scc_ind_name}_${dr_ind_name}_rbd_${hev_cf}.dta") != 1 {
.         di in red "Rerunning `object_of_interest' for SCC of $${scc} and Discount Rate of ${dr_rounded}% because Data Not Found."
.         qui do "${calculation_files}/lifetime_vehicle_externalities"
. }

. 
. if "${vehicle_car_lifetime}" == "" {
.         di in red "Rerunning `object_of_interest' for SCC of $${scc} and Discount Rate of ${dr_rounded}% because Data Not Found."
.         qui do "${calculation_files}/lifetime_vehicle_externalities"
. }

. 
. * ${hev_cf} in the file name tells you with respect to which counterfactual the hybrid rebound is calculated
. use "${user_specific_assumptions}/files_v${user_name}/Vehicle Lifetime Damages/vehicles_${scc_ind_name}_${dr_ind_name}_rbd_${hev_cf}.dta", clear

. 
.         
. local cf_types new_avg new_car clean_car muehl hybrid   

. 
. levelsof(year), local(year_loop)
2000 2001 2002 2003 2004 2005 2006 2007 2008 2009 2010 2011 2012 2013 2014 2015 2016 2017 2018 2019 2020 2021 2022 2023 2024 2025 2026 2027 2028 2029 2030 2031 2032 2033 2034 2035 203
> 6 2037 2038 2039 2040 2041 2042 2043 2044 2045 2046 2047 2048 2049 2050

. foreach y of local year_loop {
  2.         foreach c of local cf_types{
  3.                 
.                 if "`c'" == "${bev_cf}" {
  4.                         
.                         local veh_lifespan_type = substr("`c'", strpos("`c'", "_") + 1, .)
  5. 
.                         
.                         qui sum `c'_local if year == `y'
  6.                         global `c'_cf_damages_loc_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
  7. 
.                         qui sum `c'_global if year == `y' 
  8.                         global `c'_cf_damages_glob_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
  9. 
.                         qui sum `c'_CO2 if year == `y'
 10.                         global `c'_cf_carbon_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 11. 
.                         qui sum `c'_taxes if year == `y'
 12.                         global `c'_cf_gas_fisc_ext_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 13.                         
.                         qui sum `c'_savings if year == `y'
 14.                         global `c'_cf_gas_savings_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 15. 
.                         qui sum `c'_profits if year == `y'
 16.                         global `c'_wtp_prod_s_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 17. 
.                         qui sum `c'_gallons if year == `y'
 18.                         global `c'_gal_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 19.                         
.                         qui sum `c'_local_driving if year == `y'
 20.                         global `c'_driving_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
 21.                         
.                         qui sum `c'_mpg if year == `y'
 22.                         global `c'_cf_mpg_`y' = r(mean)
 23.                         
.                 }
 24.                 if "`c'" != "${bev_cf}" {
 25.                         
.                         qui sum `c'_local if year == `y' // for hybrids, includes rebound effect
 26.                         global `c'_cf_damages_loc_`y' = r(mean) // for hybrids, includes rebound effect
 27. 
.                         qui sum `c'_global if year == `y' // for hybrids, includes rebound effect
 28.                         global `c'_cf_damages_glob_`y' = r(mean) // for hybrids, includes rebound effect
 29. 
.                         qui sum `c'_CO2 if year == `y'
 30.                         global `c'_cf_carbon_`y' = r(mean)
 31. 
.                         qui sum `c'_taxes if year == `y'
 32.                         global `c'_cf_gas_fisc_ext_`y' = r(mean)
 33.                         
.                         qui sum `c'_savings if year == `y'
 34.                         global `c'_cf_gas_savings_`y' = r(mean)
 35. 
.                         qui sum `c'_profits if year == `y'
 36.                         global `c'_wtp_prod_s_`y' = r(mean)
 37. 
.                         qui sum `c'_gallons if year == `y'
 38.                         global `c'_gal_`y' = r(mean)
 39.                         
.                         qui sum `c'_local_driving if year == `y'
 40.                         global `c'_driving_`y' = r(mean)
 41.                         
.                         qui sum `c'_mpg if year == `y'
 42.                         global `c'_cf_mpg_`y' = r(mean)
 43.                         
.                 }
 44. 
.                 if "`c'" == "hybrid"{
 45.                         qui sum hybrid_rbd_local if year == `y'
 46.                         global yes_hev_rbd_loc_`y' = r(mean)
 47. 
.                         qui sum hybrid_rbd_global if year == `y'
 48.                         global yes_hev_rbd_glob_`y' = r(mean)
 49. 
.                         qui sum hybrid_rbd_CO2 if year == `y' // just the amount of carbon from the rebound effect, only relevant for hybrids
 50.                         global hybrid_rbd_CO2_`y' = r(mean)
 51.                 }
 52. 
.         }
 53.         
. }

