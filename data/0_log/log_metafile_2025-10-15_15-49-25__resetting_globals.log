. local wtp_prod_s = `total_wtp_prod_s' * (1 - 0.21) // 0.21 is the corporate average tax rate

. local gas_corp_fisc_e = `total_wtp_prod_s' * 0.21

. 
. local profits_fisc_e = `gas_corp_fisc_e' - `utility_fisc_ext'

. 
