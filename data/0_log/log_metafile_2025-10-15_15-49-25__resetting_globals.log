 27.         
.                 global yes_ev_damages_local_`y' = ${yes_ev_damages_local_`y'} * (${cpi_`y'} / ${cpi_2020})
 28.                 global yes_ev_damages_global_`y' = ${yes_ev_damages_global_`y'} * (${cpi_`y'} / ${cpi_2020})
 29.                 
.                 global yes_ev_damages_local_no_r_`y' = ${yes_ev_damages_local_no_r_`y'} * (${cpi_`y'} / ${cpi_2020})
 30.                 global yes_ev_damages_global_no_r_`y' = ${yes_ev_damages_global_no_r_`y'} * (${cpi_`y'} / ${cpi_2020})                  
