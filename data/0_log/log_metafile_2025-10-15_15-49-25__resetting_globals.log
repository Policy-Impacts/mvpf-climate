>         ((`6plus_loss' * ${kwh_price_`dollar_year'_${State}}) + ((`6plus_loss' * ${kwh_price_`dollar_year'_${State}})/`discount') * (1 - (1/(1+`discount')^(`shift_factor' - 1))))
. }

