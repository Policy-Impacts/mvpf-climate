. preserve

.         
.         if "`4'" == "baseline"{
.                 use "${user_specific_assumptions}/files_v${user_name}/Vehicle Lifetime Damages/vmt_dist_car.dta", clear
.                 qui sum vmt_avg_car if age == 1
.                 local vmt_age_1 = `r(mean)'
