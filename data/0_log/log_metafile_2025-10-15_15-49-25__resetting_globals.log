. /*-----------------------------------------------------------------------
> * Run Calculations for Different Specifications
> *-----------------------------------------------------------------------*/
. capture program drop find_most_recent_folder

. program define find_most_recent_folder, rclass
  1. 
. args pattern_suffix
  2. 
. * Find all folders in the results directory that end with the pattern
. local results_dir = "${code_files}/4_results"
  3. local folder_list = ""
  4. local folder_dates = ""
  5. 
. * Get list of all subdirectories
. qui local folders : dir "`results_dir'" dirs "*"
  6. 
. * Filter folders that end with our pattern and extract timestamps
. foreach folder of local folders {
  7.             di in red "Checking: `folder' against pattern: __`pattern_suffix'$"
  8.     if regexm("`folder'", "^([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2})__`pattern_suffix'$") {
  9.         local timestamp = regexs(1)
 10.         local folder_list = "`folder_list' `folder'"
 11.         local folder_dates = "`folder_dates' `timestamp'"
 12.         di in green "Found matching folder: `folder' (timestamp: `timestamp')"
 13.     }
 14. }
 15. 
. * If no matching folders found, display error and exit
. if "`folder_list'" == "" {
 16.     di as error "`pattern_suffix' folder has not been created, please run the masterfile first to create this folder"
 17.     exit 601
 18. }
 19. else {
 20.     * Find the most recent folder by comparing timestamps
.     local most_recent_folder = ""
 21.     local most_recent_timestamp = ""
 22.     
.     local folder_count : word count `folder_list'
 23.     
.     forvalues i = 1/`folder_count' {
 24.         local current_folder : word `i' of `folder_list'
 25.         local current_timestamp : word `i' of `folder_dates'
 26.         
.         * Convert timestamp to comparable format (remove hyphens and underscores)
.         local current_numeric = subinstr(subinstr("`current_timestamp'", "-", "", .), "_", "", .)
 27.         
.         if "`most_recent_timestamp'" == "" {
 28.             local most_recent_folder = "`current_folder'"
 29.             local most_recent_timestamp = "`current_numeric'"
 30.         }
 31.         else {
 32.             local most_recent_numeric = subinstr(subinstr("`most_recent_timestamp'", "-", "", .), "_", "", .)
 33.             if `current_numeric' > `most_recent_numeric' {
 34.                 local most_recent_folder = "`current_folder'"
 35.                 local most_recent_timestamp = "`current_numeric'"
 36.             }
 37.         }
 38.     }
 39.     
.     return local folder = "`most_recent_folder'"
 40.     di in green "Selected most recent folder: `most_recent_folder'"
 41. }
 42. 
. end

