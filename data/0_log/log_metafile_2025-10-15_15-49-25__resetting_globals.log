.         local wtp_no_ice_g = `wtp_no_ice_global_tot' * ((1 - ${USShareFutureSSC}) + ${USShareFutureSSC} * (1 - ${USShareGovtFutureSCC}))
. 
.         local total_ice_damages_glob = `wtp_no_ice_global_tot' / `beh_response' // for Latex
