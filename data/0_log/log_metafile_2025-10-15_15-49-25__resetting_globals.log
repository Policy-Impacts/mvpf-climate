. 
. local WTP_RoW = (1-(${USShareFutureSSC})) * `policy_impact' * ((`carbon_per_cookstove' * `social_cost_CO2_2020') + ((`carbon_per_cookstove' * `social_cost_CO2_2021') / (1 + `discoun
> t'))) + `wtp_marg' + `wtp_infr'

