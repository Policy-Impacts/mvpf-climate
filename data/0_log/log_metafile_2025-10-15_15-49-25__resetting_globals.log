> r
.         merge 1:1 year using "${user_specific_assumptions}/files_v${user_name}/Vehicle Lifetime Damages/vehicles_${scc_ind_name}_${dr_ind_name}_rbd_${hev_cf}.dta", nogen noreport ke
> ep(3)
.         drop hybrid* muehl*
