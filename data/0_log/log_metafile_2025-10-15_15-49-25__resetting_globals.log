. local fisc_ext_lr = -1 * (`wtp_no_ice_global_tot' + `wtp_yes_hev_global_tot' + `env_cost_wtp_global_tot' + `batt_man_ext_tot') * ${USShareFutureSSC} * ${USShareGovtFutureSCC}

