. 
.         local wtp_no_ice_global_tot = `beh_response' * ((${`bev_cf'_cf_damages_glob_2015} * `total_sales2015' + ${`bev_cf'_cf_damages_glob_2016} * `total_sales2016' + ${`bev_cf'_cf_
> damages_glob_2017} * `total_sales2017' + ${`bev_cf'_cf_damages_glob_2018} * `total_sales2018') ///
