> li_ptc}))

. 
. di "wind_clean_grid_no_lbd_avg_mvpf = " ((${WTP_cc_hitaj_ptc} + ${WTP_cc_metcalf_ptc} + ${WTP_cc_shirmali_ptc}) / (${cost_hitaj_ptc} + ${cost_metcalf_ptc} + ${cost_shirmali_ptc}))
wind_clean_grid_no_lbd_avg_mvpf = .58388986

