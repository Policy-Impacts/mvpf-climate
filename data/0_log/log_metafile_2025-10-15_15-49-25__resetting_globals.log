  5.                 }
. 
.                 local gas_consumed_year_one = (`gas_consumed_year_one_2015' * `total_sales2015' + `gas_consumed_year_one_2016' * `total_sales2016' + `gas_consumed_year_one_2017' * `
> total_sales2017' + `gas_consumed_year_one_2018' * `total_sales2018') ///
