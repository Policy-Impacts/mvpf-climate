  2.                 dynamic_split_grid `kwh_used', starting_year(`dollar_year') ext_year(`y') discount_rate(`discount') ef(${replacement}) geo("${State}") type("uniform") grid_specif
> y("yes") model(${grid_model})
  3.                 if `i' == 1{
