> tal_sales2017' + ${`bev_cf'_cf_carbon_2018} * `total_sales2018') / (`total_sales2015' + `total_sales2016' + `total_sales2017' + `total_sales2018'))
.         local q_carbon_no_ice_mck = `q_carbon_no_ice' / `beh_response'
