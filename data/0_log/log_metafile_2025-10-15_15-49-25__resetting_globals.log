. 
. global wtp_cons_`1' = `r(wtp_cons)'

. 
. global wtp_prod_`1' = `r(wtp_prod)'

. global wtp_prod_s_`1' = `r(wtp_prod_s)'

. global wtp_prod_u_`1' = `r(wtp_prod_u)' 

. 
. if "${value_profits}" == "no" {
. 
