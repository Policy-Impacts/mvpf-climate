. /* 4. Set local assumptions unique to this policy */
. ****************************************************
. ** Cost assumptions:
. * Program costs - US$
. if (`s_1' == 1 & `marg_mvpf' == 1) | (`non_marg_mvpf' == 1){
.         local rebate_cost = 9000 // Average subsidy (cf. text p. 8)
. }

. else if `s_0' == 1{
.         local rebate_cost = 0
