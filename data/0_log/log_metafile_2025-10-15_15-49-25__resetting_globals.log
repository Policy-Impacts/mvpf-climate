. /* 5. Outputs */
. ****************
. global normalize_`1' = 1

. 
. global MVPF_`1' = `MVPF'

. global WTP_USPres_`1' = `WTP_USPres'

. global WTP_USFut_`1'  = `WTP_USFut'

. global WTP_RoW_`1'    = `WTP_RoW'

. global cost_`1' = `total_cost'

. global WTP_`1' = `WTP'

