.         local ratio_incontext = `ptc_discounted'/ `lcoe_incontext'
.         local ic_scale_factor = (`ptc_discounted' / 0.01) / (`lcoe_incontext'/`avg_lcoe')
.         local semie = (`epsilon' / (`avg_lcoe' * (1 - (`ptc_real' * 100 * `ratio_incontext')))) * 0.01 * `ic_scale_factor'
. }

