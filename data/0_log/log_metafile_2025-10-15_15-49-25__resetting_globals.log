. global color_group2_`1' = 3

. global color_group3_`1' = 4

. global color_group4_`1' = 4

. global cost_color_start_`1' = 7

. global color_group5_`1' = 10

. 
. 
. global note_`1' = `"Publication: " "SCC: `scc'" "Description: "'

. global normalize_`1' = 1

. 
