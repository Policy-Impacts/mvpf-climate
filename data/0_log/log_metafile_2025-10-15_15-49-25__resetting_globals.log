. else if `s_bar' == 1{
.         local rebate_cost = 9000 / 2
. }

. local adj_rebate_cost = `rebate_cost' * (${cpi_`dollar_year'} / ${cpi_${policy_year}})

. local avg_subsidy = `adj_rebate_cost'

