. 
. local resource_cost = `purchase_price_diff' + `lifetime_energy_cost' - `lifetime_gas_cost'

. di in red "resource cost is `resource_cost'"
resource cost is 6634.205863763369

. 
. local q_carbon_yes_ev_mck = -${yes_ev_carbon_content_2020} - (59.5 * `batt_cap' * 0.001) - ${yes_ev_rbd_CO2_2020} // need to remove the rebound effect, 59.5 from Winjobi et al. (202
