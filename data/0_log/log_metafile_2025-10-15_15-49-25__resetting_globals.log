  5.                 }
  6.                 local i = `i' + 1
  7.                 local kwh_used `ev_miles_traveled`i'' * `kwh_per_mile'
  8.                 local local_benefit = `local_benefit' + `r(local_enviro_ext)'
  9.                 local global_benefit = `global_benefit' + `r(global_enviro_ext)'
 10. 
