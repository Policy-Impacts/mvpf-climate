> 14') ///
>                                                 / (`total_sales2011' + `total_sales2012' + `total_sales2013' + `total_sales2014')
.                 local batt_per_kwh_cost = `prod_cost' * (${cpi_2020} / ${cpi_2018})
.         }

.         else{
