  7. 
.                         qui sum `c'_global if year == `y' 
  8.                         global `c'_cf_damages_glob_`y' = r(mean) * ${EV_VMT_`veh_lifespan_type'_adjustment}
  9. 
.                         qui sum `c'_CO2 if year == `y'
