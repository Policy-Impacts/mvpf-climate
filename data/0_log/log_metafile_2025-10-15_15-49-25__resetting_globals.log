. local lifetime_energy_cost = 0

. forvalues y = 1(1)`ub'{
  2.         local lifetime_energy_cost = `lifetime_energy_cost' + (`ev_miles_traveled`y'' * `kwh_per_mile' * `energy_cost') / ((1 + `discount')^(`y' - 1))
  3. }

. 
. 
. 
. local purchase_price_diff = 8166 * (${cpi_2020} / ${cpi_2023}) // from vin diesel

