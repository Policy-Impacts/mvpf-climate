. * 3b - Gasoline Vehicle Externalities.
. *-----------------------------------------------------------------------
. local object_of_interest = "Gasoline Vehicle Externalities"

.         
. if "${rerun_macros}" == "yes" {
.         di in red "Asked to Rerun `object_of_interest'"
