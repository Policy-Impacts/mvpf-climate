  7.                         assert `wtp_soc' < 0
  8.         
.         }
.         
.         local wtp_soc_l = 0
.         local wtp_soc_g = `wtp_CO2'
.                 assert round(`wtp_soc_g' + `wtp_soc_l', 0.00001) == round(`wtp_soc', 0.00001)
.         
