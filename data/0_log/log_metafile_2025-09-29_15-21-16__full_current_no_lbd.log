>                            inlist("`i'", "spill_muni_fed_fe", "treated_muni_fed_fe"){
 10.                                 local `original' = trim("`: display %9.0fc ``original'''")
 11.                         }
 12.                         else if inlist("`i'", "wtp_cons_spill_n"){
 13.                                 local `original' = trim("`: display %5.3fc ``original'''")
 14.                         }
 15.                         else{
 16.                                 local `original' = trim("`: display %5.2fc ``original'''")
 17.                         }
 18.                         local command = "\newcommand{\\`newname'`1'`4'}{``original''}"
 19.                         di "`command'"
 20.                         file write myfile "`command'" _n
 21.                         
.                 }
.                 file close myfile
. 
.         }
. 
. }

.         
. 
end of do-file
