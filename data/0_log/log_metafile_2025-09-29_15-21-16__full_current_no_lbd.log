. di `WTP_RoW' + `WTP_USFut' + `WTP_USPres'
-30.130462

. di (`WTP_USFut' + `WTP_USPres')/`total_cost'
-.3727769

. 
. di `per_change_wood_2'
-.04624963

. di `cookstove_externality' * `per_change_wood_1'
4.4268575

. di `cookstove_externality' * `per_change_wood_2'
-31.390444

. 
end of do-file
