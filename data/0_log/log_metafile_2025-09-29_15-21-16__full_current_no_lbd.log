. local q_carbon_cost_curve_mck = `q_carbon_cost_curve' / `beh_response'

. local q_carbon_mck = `q_carbon_no_ice_mck' + `q_carbon_yes_ev_mck' + `q_carbon_rbd_mck'

. local q_carbon = `q_carbon' + `q_carbon_cost_curve'

