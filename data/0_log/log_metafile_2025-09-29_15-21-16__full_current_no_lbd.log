. }

. 
. 
. local fed_fisc_ext = `beh_response' * `avg_fed_subsidy'

. local avg_fed_subsidy_n = `avg_fed_subsidy' / `net_msrp'

. 
. local beh_fisc_ext = `semie' * `avg_subsidy'

. 
. if `marg_mvpf' == 1{
