. 
. }

. 
. global note_`1' = `"Publication: West and Williams 2007" "Global Assumptions: ${scc_ind_name}, ${dr_ind_name}" "Description: Gasoline Price of $`r(consumer_price_return)' (`dollar_year
> ' dollars). `cc_note_gas_taxes' "'

. 
