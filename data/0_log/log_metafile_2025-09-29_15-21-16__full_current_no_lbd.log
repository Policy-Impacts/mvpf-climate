. /* 5. Outputs */
. ****************
. wind_ado, policy_year(${policy_year}) inflation_year(${policy_year}) spec(${spec_type}) replacement(`replacement') capacity_factor_context(`capacity_factor_context') size_context(`aver
> age_size') semie(`semie') p_name("hitaj_ger") marg_sales(`marg_sales') cum_sales(`cum_sales') prod_cost(`prod_cost') epsilon(`epsilon') farmer_theta(`farmer_theta') subsidy_max(`subsid
