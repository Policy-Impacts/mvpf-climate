.                 local tot_gal = `tot_gal_cf' - `tot_gal_hy' // for Latex
.                 local gas_markup = ${nominal_gas_markup_`dollar_year'} // for Latex
. 
.                 local wtp_prod_s = `beh_response' * (${hybrid_wtp_prod_s_`dollar_year'} - ${`hev_cf'_wtp_prod_s_`dollar_year'})
.         }
. }

