. global wtp_loc_`1' = `local_pollutants'

. 
. global wtp_prod_`1' = -`corporate_loss'

. global wtp_r_loc_`1' = -`rebound_local'

. global wtp_r_glob_`1' = -`rebound_global'

. 
. 
. global fisc_ext_t_`1' = `fisc_ext_t'

. global fisc_ext_s_`1' = `fisc_ext_s'

