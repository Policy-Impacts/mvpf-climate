. local utility_fisc_ext = 0

. forvalues y = 1(1)`ub'{
  2.         local utility_fisc_ext = `utility_fisc_ext' + (`beh_response' * `ev_miles_traveled`y'' * `kwh_per_mile' * `util_gov_revenue') / ((1 + `discount')^(`y' - 1)) // gain in profi
> t tax from highter utility profits + gain in gov revenue since 28% of utilities are publicly owned (EIA 2019)
  3. }

. 
. if "`4'" == "baseline"{
.         local gas_fisc_ext = 0
.         forvalues y = 1(1)`ub'{
  2.                 local gas_fisc_ext = `gas_fisc_ext' + ((`beh_response' * (`ice_miles_traveled`y'' / `ev_cf_mpg') * `tax_rate') / ((1+`discount')^(`y' - 1)))
  3.         }
. }

. else{
