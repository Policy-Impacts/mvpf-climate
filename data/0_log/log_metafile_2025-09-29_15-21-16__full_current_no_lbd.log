. 
. if "`1'" != "" global name = "`1'"

. local bootstrap = "`2'"

. if "`3'" != "" global folder_name = "`3'"

. if "`bootstrap'" == "yes" {
. *       if ${draw_number} ==1 {
.                 preserve
