. *********************************
. /* 5. Calculate Environmental Externality */
. *********************************
. 
.         *********************************
.         /* 5a. Import Social Costs and Parameters*/
.         *********************************
.         preserve

. 
.                 local ghg CO2 CH4 N2O

.                 foreach g of local ghg {
  2.                         
.                         local social_cost_`g' = ${sc_`g'_`dollar_year'} * (${cpi_`dollar_year'} / ${cpi_${sc_dollar_year}})
  3.                                 
.                 }       

