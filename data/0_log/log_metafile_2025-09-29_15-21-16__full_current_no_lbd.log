. 
. assert round(${cost_`1'}, 0.0001) == round(${program_cost_`1'} + ${fisc_ext_t_`1'} + ${fisc_ext_s_`1'} + ${fisc_ext_lr_`1'}, 0.0001)

. assert round(${MVPF_`1'}, 0.0001) == round(${WTP_`1'}/${cost_`1'}, 0.0001)

