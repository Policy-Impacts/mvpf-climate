> ers"' 9 `"Total WTP"' 11 `""Program" "Cost""' 12 `""FE" "Subsidies""' 13 `""FE" "Taxes""' 14 `""FE" "Long-Run""' 15 `"Total Cost"' ///
> 

. *color groupings
. global color_group1_`1' = 3

