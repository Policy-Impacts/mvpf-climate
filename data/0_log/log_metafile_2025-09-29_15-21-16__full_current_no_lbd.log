. local subsidy_percent = 0.2/0.9 // The actual subsidy percent is 20% of the marginal price. We don't observe the marginal price, but we know in context that the price is 0.90 for non-c
> are and care recipients pay 0.7, so we infer a 22% subsidy on the market price

.         
. if "`4'" == "baseline" | "`4'" == "baseline_gen" {
.                 
.         local ng_price = 0.9
.         local subsidy_size = 0.2 // Table in Appendix B.1
. }

. 
. if "`4'" == "current"{
