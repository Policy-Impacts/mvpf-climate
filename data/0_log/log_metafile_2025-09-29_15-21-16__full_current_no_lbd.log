.         ** --------------------- COST CURVE --------------------- **
.         if "`4'" == "baseline"{
. 
.                 cost_curve_masterfile, demand_elas(`epsilon') discount_rate(`discount') farmer(`farmer_theta') fcr(`fixed_cost_frac') /// 
>                                                            curr_prod(`marg_sales') cum_prod(`cum_sales') price(`net_msrp') enviro(ev_local) ///
