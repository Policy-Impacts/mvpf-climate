. local fisc_ext_prod = (`consumer_price'*`pct_markup')*`semi_e_demand_jet_tax'*(${gasoline_effective_corp_tax})

. //      assert `fisc_ext_prod' <= 0
. 
.         
. if "${value_profits}" == "no" {
