-------------+---------------------------------------------------------
          pe |          1        -.35           .       -.35       -.35

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
          pe |          1       -.421           .      -.421      -.421
.         restore
. }

. if "`bootstrap'" == "pe_ci" {
