-------------+---------------------------------------------------------
          pe |          1         199           .        199        199
.     restore
. }

. 
. 
. ****************************************************
. /* 3. Set local assumptions unique to this policy */
. ****************************************************
. 
.     ****************************************************
.     /* 3a. Set Dollar Year and Policy Year */
.     ****************************************************
. 
.     preserve

. 
.         if "`4'" == "baseline"{
.             
.             local dollar_year = ${policy_year}
.             
.         }

.         
.         if "`4'" == "current"{
.             
