.         restore
. }

. if "`bootstrap'" == "pe_ci" {
.         preserve
.                 use "${code_files}/2b_causal_estimates_draws/${folder_name}/${ts_causal_draws}/${name}_ci_pe.dta", clear
.                 
. levelsof estimate, local(estimates)
. 
. 
