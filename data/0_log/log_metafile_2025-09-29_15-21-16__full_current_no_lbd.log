  5.                                 local newname = subinstr("`newname'", "_", "", .)
  6.                         }
  7.                         local 1 = subinstr("`1'", "_", "", .)
  8.                         local 4 = subinstr("`4'", "_", "", .)
  9. 
.                         local `original' = trim("`: display %5.2fc ``original'''")
 10.                         local command = "\newcommand{\\`newname'`1'`4'`mc_assumption'}{``original''}"
 11.                         di "`command'"
 12.                         file write myfile "`command'" _n
 13.                         
.                 }
.                 file close myfile
. 
.         }
. 
. }

