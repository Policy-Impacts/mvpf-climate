. 
. if "${value_savings}" == "yes" & "`4'" == "current" {
.         
.         local wtp_savings = `beh_response' * (${`bev_cf'_cf_gas_savings_`dollar_year'} - ${yes_ev_savings_`dollar_year'}) 
.         
. }

. else {
.         
.         local wtp_savings = 0
.         
