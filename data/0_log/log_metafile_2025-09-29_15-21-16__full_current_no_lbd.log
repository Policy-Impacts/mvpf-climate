. ****************************************************
. preserve

. 
.         use "${user_specific_assumptions}/files_v${user_name}/Gasoline Externalities/gasoline_vehicle_externalities_no_ethanol_${scc_ind_name}_${dr_ind_name}.dta", clear

.                 keep if year == `dollar_year'
