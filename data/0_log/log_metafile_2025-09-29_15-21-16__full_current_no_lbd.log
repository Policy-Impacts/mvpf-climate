. ****************************************************
. /* 3h. Subsidy Levels */
. ****************************************************
. ** State Subsidy
. 
. local elas_avg_state_subsidy = (2011 * 465 + 1037 * 173) / (465 + 173) // from Table 3 of Gallagher and Muehlegger (2011)

. if "`4'" == "baseline" | "`4'" == "baseline_gen"{
.         local avg_state_subsidy = `elas_avg_state_subsidy'
. }

. else{
