. global prop_infra_`1' = .

. global wtp_cons_`1' = `wtp_consumers'

. global wtp_glob_`1' = `wtp_society' * (1 - (${USShareFutureSSC} * ${USShareGovtFutureSCC}))

. global wtp_loc_`1' = 0

. 
