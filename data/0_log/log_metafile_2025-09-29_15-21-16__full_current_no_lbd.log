. global WTP_RoW_`1'    = `WTP_RoW'

. global total_cost_`1' = `total_cost'

. 
. ** for waterfall charts
. 
. global wtp_comps_`1' wtp_cons wtp_glob wtp_loc WTP

. global wtp_comps_`1'_commas "wtp_cons", "wtp_glob" ,"wtp_loc", "WTP"

. 
